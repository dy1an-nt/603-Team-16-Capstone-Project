{
  "name": "resume-reviewer",
  "private": true,
  "description": "npm shortcuts for the Python backend, which also serves the frontend. No npm packages to install.",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "setup": "node scripts/py.mjs setup",
    "backend": "node scripts/py.mjs -m uvicorn app.main:app --reload",
    "lint": "node scripts/py.mjs -m ruff check .",
    "test": "node scripts/py.mjs -m pytest",
    "check": "npm run lint && npm test"
  }
}
